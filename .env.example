# ==============================================================================
# CYBER SWARM TRADING OS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local setup.
# Never commit real credentials, accounts, or secrets to version control.

# Operating Mode: LIVE | PAPER | BACKTEST | SAFE
CYBER_SWARM_MODE=PAPER

# Autonomous Trading Desk
CYBER_SWARM_DESK_ID=QUANT-DESK-01
CYBER_SWARM_AUTO_TRADE=true
CYBER_SWARM_DEFAULT_LOT=0.10

# Telemetry Server & Web UI
CYBER_SWARM_HOST=0.0.0.0
CYBER_SWARM_PORT=8420
CYBER_SWARM_WS_INTERVAL=1.0

# Capital & Portfolio Risk Limits
CYBER_SWARM_INITIAL_EQUITY=1482920.45
CYBER_SWARM_MAX_RISK_PER_TRADE_PCT=10.0
CYBER_SWARM_MAX_DRAWDOWN_PCT=5.0
CYBER_SWARM_MAX_EXPOSURE_PCT=40.0
CYBER_SWARM_MAX_OPEN_POSITIONS=8

# MT5 Bridge Communication
CYBER_SWARM_MT5_REQUEST_FILE=request.txt
CYBER_SWARM_MT5_DATA_FILE=candles.csv

# Logging
LOG_LEVEL=INFO
